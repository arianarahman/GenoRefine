      "path": "HPCBDataset/Dataset/human_pancreas_norm_complexBatch.h5ad",
      "label_key": "celltype",
      "batch_key": "tech",
      "annotation_policy": {
        "named_labels_allowed": true,
        "partition_description": "Agreement with supplied HP-CB celltype annotations; independence/provenance pending.",
        "restriction_reason": "Do not claim independent marker validation or independence from the five-study pancreas cohort."
      }
    },
    "mouse_senis": {
      "format": "h5ad",
      "path": "MouseDataset/Dataset/tabula-muris_sub50k_combined.h5ad",
      "label_key": "cell_ontology_class",
      "batch_key": "dataset",
      "annotation_policy": {
        "named_labels_allowed": true,
        "partition_description": "Agreement with supplied Senis cell_ontology_class annotations; source/subsampling lineage pending.",
        "restriction_reason": "Retain donor, tissue, age and method metadata; droplet/FACS are not unconfounded batch replicates."
      }
    },
    "pbmc_control": {
      "format": "h5ad",
