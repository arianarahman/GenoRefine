      "label_variable": "classLabel",
      "annotation_policy": {
        "named_labels_allowed": false,
        "partition_description": "Agreement with supplied MAT class codes; independent annotation provenance pending.",
        "restriction_reason": "Original biological label mapping is unverified; old script names only 1–14, while code 15 is present."
      }
    },
    "hpcb": {
