FROM nvcr.io/nvidia/tensorflow:25.02-tf2-py3

# NVIDIA's image supplies the CUDA 12.8/cuDNN/TensorFlow stack needed by the
# RTX 50-series GPU. POT is the only project dependency absent from that image.
# --no-deps prevents replacement of its validated numerical stack.
RUN python -m pip install --no-cache-dir --no-deps POT==0.9.6.post1

ENV TF_USE_LEGACY_KERAS=0 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    TF_ENABLE_ONEDNN_OPTS=1 \
    PYTHONDONTWRITEBYTECODE=1
